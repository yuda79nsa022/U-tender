# Production build: compiles the app once at image-build time, then serves
# the static output with nginx. Unlike Dockerfile (which runs "vite dev" --
# fine for a laptop, never meant to be reachable from the internet), this
# is what actually gets deployed to a server.
FROM node:20-slim AS build
WORKDIR /app
COPY package.json .
RUN npm install
COPY . .

# Vite bakes VITE_* variables into the built JS at build time, not at
# container-start time -- so the API URL the deployed frontend calls has
# to be supplied here as a build arg, not as a normal runtime environment
# variable the way docker-compose.yml's dev frontend service uses it.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
